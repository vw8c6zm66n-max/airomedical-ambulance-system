// server.js
const express = require('express');
const mongoose = require('mongoose');
const cors = require('cors');

const app = express();
app.use(express.json());

// Enable CORS so your frontend can communicate with this backend
app.use(cors({
    origin: '*' // In production, replace with your actual frontend URL for better security
}));

// Define the Mission Schema directly inside the server file for simplicity
const MissionSchema = new mongoose.Schema({
    missionId: { type: String, required: true, unique: true },
    patientInitials: { type: String, required: true },
    triageCategory: { type: String, enum: ['P1 - Critical', 'P2 - Urgent', 'P3 - Stable'], required: true },
    sendingFacility: { type: String, required: true },
    receivingFacility: { type: String, required: true },
    assignedAircraft: { type: String, required: true },
    missionStatus: { type: String, default: 'Dispatched' },
    coordinates: { latitude: Number, longitude: Number },
    timestamp: { type: Date, default: Date.now }
});

const Mission = mongoose.model('Mission', MissionSchema);

// Fallback to a test database if the environment variable isn't set yet
const dbURI = process.env.MONGODB_URI || "mongodb://localhost:27017/aaptms_local";

mongoose.connect(dbURI)
    .then(() => console.log("AAPTMS Secure Cloud Database Connected"))
    .catch(err => console.error("Database connection error:", err));

// API Endpoint to receive a new transfer request
app.post('/api/missions/dispatch', async (req, res) => {
    try {
        const newMission = new Mission(req.body);
        await newMission.save();
        res.status(201).json({ success: true, data: newMission });
    } catch (error) {
        res.status(500).json({ success: false, error: error.message });
    }
});

// API Endpoint to get all active air ambulance flights
app.get('/api/missions/active', async (req, res) => {
    try {
        const activeMissions = await Mission.find();
        res.status(200).json({ success: true, data: activeMissions });
    } catch (error) {
        res.status(500).json({ success: false, error: error.message });
    }
});

// Dynamic Port for cloud providers (like Render or Railway)
const PORT = process.env.PORT || 5000;
app.listen(PORT, () => console.log(`AAPTMS Control Server online on port ${PORT}`));
